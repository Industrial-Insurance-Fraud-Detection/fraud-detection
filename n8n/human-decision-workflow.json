    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst body = item.body;\nconst claimId = body.claimId;\nconst reference = body.reference;\nconst clientName = body.clientName;\nconst notes = body.notes;\nconst date = new Date().toLocaleDateString('fr-DZ', {\n  year: 'numeric', month: 'long', day: 'numeric'\n});\n\nconst html = `\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    body { font-family: Arial, sans-serif; padding: 40px; color: #1a1a1a; }\n    .header { text-align: center; border-bottom: 3px solid #16a34a; padding-bottom: 20px; margin-bottom: 30px; }\n    .logo { font-size: 28px; font-weight: bold; color: #16a34a; }\n    .subtitle { color: #666; font-size: 14px; }\n    .badge { background: #16a34a; color: white; padding: 8px 20px; border-radius: 20px; font-size: 16px; display: inline-block; margin: 20px 0; }\n    .section { margin: 20px 0; }\n    .label { font-weight: bold; color: #444; font-size: 13px; text-transform: uppercase; }\n    .value { font-size: 15px; margin-top: 4px; }\n    .notes-box { background: #f0fdf4; border-left: 4px solid #16a34a; padding: 15px; margin: 20px 0; }\n    .footer { margin-top: 50px; border-top: 1px solid #ddd; padding-top: 20px; font-size: 12px; color: #999; text-align: center; }\n  </style>\n</head>\n<body>\n  <div class=\"header\">\n    <div class=\"logo\">TAAMINE</div>\n    <div class=\"subtitle\">Plateforme de Détection de Fraude Industrielle</div>\n  </div>\n\n  <div style=\"text-align:center\">\n    <div class=\"badge\">✓ SINISTRE APPROUVÉ</div>\n  </div>\n\n  <div class=\"section\">\n    <div class=\"label\">Référence du sinistre</div>\n    <div class=\"value\">${reference}</div>\n  </div>\n\n  <div class=\"section\">\n    <div class=\"label\">Client</div>\n    <div class=\"value\">${clientName}</div>\n  </div>\n\n  <div class=\"section\">\n    <div class=\"label\">Date de décision</div>\n    <div class=\"value\">${date}</div>\n  </div>\n\n  <div class=\"notes-box\">\n    <div class=\"label\">Notes de l'investigateur</div>\n    <div class=\"value\">${notes}</div>\n  </div>\n\n  <div class=\"footer\">\n    Ce document est généré automatiquement par la plateforme .<br>\n    Pour toute question, contactez votre gestionnaire de sinistres.\n  </div>\n</body>\n</html>\n`;\n\nreturn [{ json: { html, claimId, reference, clientName } }];"
